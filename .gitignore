# Data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Models — weights are excluded by default, except the trained detector,
# which is committed so the Streamlit demo works straight after cloning.
models/*.pt
models/*.pth
models/*.onnx
!models/fasterrcnn.pt
!models/.gitkeep

# Virtual environments (any name)
venv/
.venv*/
env/

# Leftover pip temp dirs (Windows)
~*/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
*.log

# OS / IDE
.DS_Store
.vscode/
.idea/
